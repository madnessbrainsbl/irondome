# Antigravity direct mode.
# Do not set an app-wide proxy; it breaks Electron UI/webviews and can leak into child tools.
IRON_ANTIGRAVITY_PROXY=
IRON_ANTIGRAVITY_NO_PROXY=localhost,127.0.0.1,127.0.0.0/8,::1
IRON_ANTIGRAVITY_EXPORT_PROXY_ENV=no
IRON_ANTIGRAVITY_BYPASS_GROUP=antigravity-direct
IRON_ANTIGRAVITY_STRICT_BYPASS=no
