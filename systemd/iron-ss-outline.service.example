[Unit]
Description=Iron Dome Outline over Tor
After=iron-tor.service
Requires=iron-tor.service

[Service]
Type=simple
User=cliproxysvc
Group=cliproxysvc
ExecStartPre=-+/usr/sbin/setcap -r /usr/bin/ss-local
ExecStart=/usr/local/libexec/iron-ss-outline-start
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
